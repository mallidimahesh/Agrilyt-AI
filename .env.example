# API Keys Configuration
# Copy this file to .env and add your actual API keys

# Data.gov.in API Key
# Get your key from: https://data.gov.in/
# Register and generate an API key for the mandi prices dataset
DATA_GOV_API_KEY=your_api_key_here

# IMD API Configuration
# IMD APIs typically require IP whitelisting
# The public endpoint will be used as fallback
IMD_API_ENABLED=false

# Model Configuration
USE_PROPHET_MODEL=true
USE_ARIMA_MODEL=true
PREDICTION_DAYS=14
